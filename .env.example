# Database Configuration
DB_ROOT_PASSWORD=your_db_root_password
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name
DB_HOST=mysql-container
DB_PORT=3306

# Redis Configuration
SPRING_DATA_REDIS_HOST=redis-container
SPRING_DATA_REDIS_PORT=6379

# JWT Secret Key
JWT_SECRET_KEY=your_jwt_secret_key_here

# AI Server Configuration
AI_SERVER_URL=http://ai-container:8000
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
HF_TOKEN=your_huggingface_token_here

# Qdrant Vector DB Configuration
QDRANT_HOST=qdrant-container
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=taco_problems

# Mail Configuration
MAIL_PASSWORD=your_gmail_app_password_here

# External APIs
JUDGE_URL=http://judge_server_url:port
PAPAGO_CLIENT_ID=your_papago_client_id_here
PAPAGO_CLIENT_SECRET=your_papago_client_secret_here
PAPAGO_URL=https://papago.apigw.ntruss.com/

# OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OpenVidu Configuration (Not currently in use)
OPENVIDU_URL=http://localhost:4443/
OPENVIDU_SECRET=your_openvidu_secret_here

# Application URLs
BASE_URL=http://your_backend_url:8080
FRONT_BASE_URL=https://your_frontend_domain
FILE_UPLOAD_DIR=/home/ubuntu/uploads
